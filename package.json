    "menus": {
      "view/title": [
        {
          "command": "skillNinja.openWorkspaceOutput",
          "when": "view == skillNinja.installedView",
          "group": "navigation@1"
        },
        {
          "command": "skillNinja.updateInstruction",
          "when": "view == skillNinja.installedView",
          "group": "navigation@2"
        },
        {
          "command": "skillNinja.createSkill",
          "when": "view == skillNinja.installedView",
          "group": "navigation@3"
        },
        {
          "command": "skillNinja.refresh",
          "when": "view == skillNinja.installedView",
          "group": "navigation@4"
        },
        {
          "command": "skillNinja.openSettings",
          "when": "view == skillNinja.installedView",
          "group": "z_refresh@1"
        },
        {
          "command": "skillNinja.resetSettings",
          "when": "view == skillNinja.installedView",
          "group": "z_reset@1"
        },
        {
          "command": "skillNinja.reportBug",
          "when": "view == skillNinja.installedView",
          "group": "z_reset@2"
        },
        {
          "command": "skillNinja.openUserGlobalOutput",
          "when": "view == skillNinja.userGlobalView",
          "group": "navigation@1"
        },
        {
          "command": "skillNinja.updateInstruction",
          "when": "view == skillNinja.userGlobalView",
          "group": "navigation@2"
        },
        {
          "command": "skillNinja.createSkill",
          "when": "view == skillNinja.userGlobalView",
          "group": "navigation@3"
        },
        {
          "command": "skillNinja.refresh",
          "when": "view == skillNinja.userGlobalView",
          "group": "navigation@4"
        },
        {
          "command": "skillNinja.showBuiltInSkills",
          "when": "view == skillNinja.userGlobalView && config.skillNinja.showBuiltInSkills == false",
          "group": "navigation@5"
        },
        {
          "command": "skillNinja.openSettings",
          "when": "view == skillNinja.userGlobalView",
          "group": "z_refresh@1"
        },
        {
          "command": "skillNinja.resetSettings",
          "when": "view == skillNinja.userGlobalView",
          "group": "z_reset@1"
        },
        {
          "command": "skillNinja.reportBug",
          "when": "view == skillNinja.userGlobalView",
          "group": "z_reset@2"
        },
        {
          "command": "skillNinja.search",
          "when": "view == skillNinja.browseView",
          "group": "navigation@1"
        },
        {
          "command": "skillNinja.webSearch",
          "when": "view == skillNinja.browseView",
          "group": "navigation@2"
        },
        {
          "command": "skillNinja.updateIndex",
          "when": "view == skillNinja.browseView",
          "group": "navigation@3"
        },
        {
          "command": "skillNinja.addSource",
          "when": "view == skillNinja.browseView",
          "group": "navigation@4"
        },
        {
          "command": "skillNinja.createSkill",
          "when": "view == skillNinja.browseView",
          "group": "navigation@5"
        },
        {
          "command": "skillNinja.openSettings",
          "when": "view == skillNinja.browseView",
          "group": "z_refresh@1"
        }
      ],
      "view/item/context": [
        {
          "command": "skillNinja.install",
          "when": "view == skillNinja.browseView && viewItem == skill",
          "group": "inline@1"
        },
        {
          "command": "skillNinja.preview",
          "when": "view == skillNinja.browseView && viewItem == skill",
          "group": "inline@2"
        },
        {
          "command": "skillNinja.toggleFavorite",
          "when": "view == skillNinja.browseView && viewItem == skill",
          "group": "inline@3"
        },
        {
          "command": "skillNinja.openOnGitHub",
          "when": "view == skillNinja.browseView && (viewItem == skill || viewItem == source)",
          "group": "inline@4"
        },
        {
          "command": "skillNinja.uninstall",
          "when": "view == skillNinja.installedView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill)",
          "group": "inline"
        },
        {
          "command": "skillNinja.uninstall",
          "when": "view == skillNinja.userGlobalView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill)",
          "group": "inline"
        },
        {
          "command": "skillNinja.reinstall",
          "when": "view == skillNinja.installedView && viewItem == managedSkill",
          "group": "inline"
        },
        {
          "command": "skillNinja.reinstall",
          "when": "view == skillNinja.userGlobalView && viewItem == managedSkill",
          "group": "inline"
        },
        {
          "command": "skillNinja.editWhenToUse",
          "when": "view == skillNinja.installedView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill)",
          "group": "navigation"
        },
        {
          "command": "skillNinja.editWhenToUse",
          "when": "view == skillNinja.userGlobalView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill)",
          "group": "navigation"
        },
        {
          "command": "skillNinja.openSkillFolder",
          "when": "view == skillNinja.installedView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill || viewItem == builtInSkill || viewItem == extensionSkill)",
          "group": "inline"
        },
        {
          "command": "skillNinja.openSkillFolder",
          "when": "view == skillNinja.userGlobalView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill || viewItem == builtInSkill || viewItem == extensionSkill)",
          "group": "inline"
        },
        {
          "command": "skillNinja.openSkillFile",
          "when": "view == skillNinja.installedView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill || viewItem == builtInSkill || viewItem == extensionSkill)",
          "group": "inline"
        },
        {
          "command": "skillNinja.openSkillFile",
          "when": "view == skillNinja.userGlobalView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill || viewItem == builtInSkill || viewItem == extensionSkill)",
          "group": "inline"
        },
        {
          "command": "skillNinja.removeSource",
          "when": "view == skillNinja.browseView && viewItem == source",
          "group": "inline"
        },
        {
          "command": "skillNinja.updateSourceIndex",
          "when": "view == skillNinja.browseView && viewItem == source",
          "group": "navigation@1"
        },
        {
          "command": "skillNinja.registerLocalSkill",
          "when": "view == skillNinja.installedView && viewItem == managedUnregisteredSkill",
          "group": "inline"
        },
        {
          "command": "skillNinja.registerLocalSkill",
          "when": "view == skillNinja.userGlobalView && viewItem == managedUnregisteredSkill",
          "group": "inline"
        },
        {
          "command": "skillNinja.unregisterLocalSkill",
          "when": "view == skillNinja.installedView && viewItem == managedSkill",
          "group": "navigation"
        },
        {
          "command": "skillNinja.unregisterLocalSkill",
          "when": "view == skillNinja.userGlobalView && viewItem == managedSkill",
          "group": "navigation"
        },
        {
          "command": "skillNinja.installBundle",
          "when": "view == skillNinja.browseView && viewItem == bundle",
          "group": "inline"
        },
        {
          "command": "skillNinja.copyUrl",
          "when": "view == skillNinja.browseView && (viewItem == skill || viewItem == source)",
          "group": "navigation@1"
        },
        {
          "command": "skillNinja.copyPath",
          "when": "view == skillNinja.installedView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill || viewItem == builtInSkill || viewItem == extensionSkill)",
          "group": "navigation@1"
        },
        {
          "command": "skillNinja.copyPath",
          "when": "view == skillNinja.userGlobalView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill || viewItem == builtInSkill || viewItem == extensionSkill)",
          "group": "navigation@1"
        },
        {
          "command": "skillNinja.openInTerminal",
          "when": "view == skillNinja.installedView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill || viewItem == builtInSkill || viewItem == extensionSkill)",
          "group": "navigation@2"
        },
        {
          "command": "skillNinja.openInTerminal",
          "when": "view == skillNinja.userGlobalView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill || viewItem == builtInSkill || viewItem == extensionSkill)",
          "group": "navigation@2"
        },
        {
          "command": "skillNinja.explainSkillState",
          "when": "view == skillNinja.installedView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill)",
          "group": "navigation@3"
        },
        {
          "command": "skillNinja.explainSkillState",
          "when": "view == skillNinja.userGlobalView && (viewItem == managedSkill || viewItem == managedUnregisteredSkill || viewItem == managedPendingSkill)",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "skillNinja.registerLocalSkill",
          "when": "false"
        },
        {
          "command": "skillNinja.unregisterLocalSkill",
          "when": "false"
        },
        {
          "command": "skillNinja.openWorkspaceOutput",
          "when": "false"
        },
        {
          "command": "skillNinja.openUserGlobalOutput",
          "when": "false"
        },
        {
          "command": "skillNinja.explainSkillState",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Skills Ninja",
      "properties": {
        "skillNinja.autoUpdateInstruction": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "markdownDescription": "%config.autoUpdateInstruction.markdownDescription%"
        },
        "skillNinja.autoUpdateSkillsOnUpgrade": {
          "type": "string",
          "default": "prompt",
          "order": 11,
          "enum": [
            "always",
            "prompt",
            "never"
          ],
          "enumDescriptions": [
            "%config.autoUpdateSkillsOnUpgrade.always%",
            "%config.autoUpdateSkillsOnUpgrade.prompt%",
            "%config.autoUpdateSkillsOnUpgrade.never%"
          ],
          "markdownDescription": "%config.autoUpdateSkillsOnUpgrade.markdownDescription%"
        },
        "skillNinja.instructionFile": {
          "type": "string",
          "default": "AGENTS.md",
          "order": 2,
          "enum": [
            "AGENTS.md",
            ".github/copilot-instructions.md",
            ".github/instructions/SkillList.instructions.md",
            "CLAUDE.md",
            ".cursor/rules/skills.mdc",
            ".windsurfrules",
            ".clinerules",
            "custom"
          ],
          "enumDescriptions": [
            "%config.instructionFile.agents%",
            "%config.instructionFile.copilot%",
            "%config.instructionFile.instructions%",
            "%config.instructionFile.claude%",
            "%config.instructionFile.cursor%",
            "%config.instructionFile.windsurf%",
            "%config.instructionFile.cline%",
            "%config.instructionFile.custom%"
          ],
          "markdownDescription": "%config.instructionFile.markdownDescription%"
        },
        "skillNinja.customInstructionPath": {
          "type": "string",
          "default": "",
          "order": 3,
          "markdownDescription": "%config.customInstructionPath.markdownDescription%"
        },
        "skillNinja.includeLocalSkills": {
          "type": "boolean",
          "default": true,
          "order": 90,
          "markdownDescription": "%config.includeLocalSkills.markdownDescription%"
        },
        "skillNinja.skillsDirectory": {
          "type": "string",
          "default": ".github/skills",
          "order": 4,
          "description": "%config.skillsDirectory.description%"
        },
        "skillNinja.useVsCodeAgentSkillLocations": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "description": "%config.useVsCodeAgentSkillLocations.description%",
          "markdownDescription": "%config.useVsCodeAgentSkillLocations.markdownDescription%"
        },
        "skillNinja.showBuiltInSkills": {
          "type": "boolean",
          "default": false,
          "order": 6,
          "description": "%config.showBuiltInSkills.description%",
          "markdownDescription": "%config.showBuiltInSkills.markdownDescription%"
        },
        "skillNinja.githubToken": {
          "type": "string",
          "default": "",
          "order": 12,
          "markdownDescription": "%config.githubToken.markdownDescription%"
        },
        "skillNinja.language": {
          "type": "string",
          "default": "auto",
          "order": 10,
          "enum": [
            "auto",
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.ja%"
          ],
          "description": "%config.language.description%"
        },
        "skillNinja.outputFormat": {
          "type": "string",
          "default": "ref",
          "order": 7,
          "enum": [
            "ref",
            "full",
            "compact",
            "legacy"
          ],
          "enumDescriptions": [
            "%config.outputFormat.ref%",
            "%config.outputFormat.full%",
            "%config.outputFormat.compact%",
            "%config.outputFormat.legacy%"
          ],
          "markdownDescription": "%config.outputFormat.markdownDescription%"
        },
        "skillNinja.refCatalogPath": {
          "type": "string",
          "default": ".github/skills/README.md",
          "order": 8,
          "markdownDescription": "%config.refCatalogPath.markdownDescription%"
        },
        "skillNinja.refCatalogFormat": {
          "type": "string",
          "default": "full",
          "order": 9,
          "enum": [
            "full",
            "compact",
            "legacy"
          ],
          "enumDescriptions": [
            "%config.outputFormat.full%",
            "%config.outputFormat.compact%",
            "%config.outputFormat.legacy%"
          ],
          "markdownDescription": "%config.refCatalogFormat.markdownDescription%"
        },
        "skillNinja.singleClickInstall": {
          "type": "boolean",
          "default": false,
          "order": 13,
          "description": "%config.singleClickInstall.description%",
          "markdownDescription": "%config.singleClickInstall.markdownDescription%"
        },
        "skillNinja.coexistenceMode": {
          "type": "string",
          "default": "auto",
          "order": 14,
          "enum": [
            "auto",
            "independent"
          ],
          "enumDescriptions": [
            "%config.coexistenceMode.auto%",
            "%config.coexistenceMode.independent%"
          ],
          "markdownDescription": "%config.coexistenceMode.markdownDescription%"
        },
        "skillNinja.useSharedSourcesManifest": {
          "type": "boolean",
          "default": false,
          "order": 15,
          "markdownDescription": "%config.useSharedSourcesManifest.markdownDescription%"
        },
        "skillNinja.versionInfo": {
          "type": "null",
          "order": 100,
          "markdownDescription": "%config.versionInfo.markdownDescription%"
        },
        "skillNinja.companionExtension": {
          "type": "null",
          "order": 101,
          "markdownDescription": "%config.companionExtension.markdownDescription%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node scripts/test-whenToUse.js && node scripts/test-search-logic.js && node scripts/test-search-ux.js && node scripts/test-skill-scan-paths.js && node scripts/test-skill-locations.js && node scripts/test-local-skill-scanner.js && node scripts/test-shared-sources-manifest.js && node scripts/test-installed-skill-index.js && node scripts/test-workspace-skill-groups.js && node scripts/test-view-welcome-ux.js && node scripts/test-package-manifest.js && node scripts/test-coexistence.js && node scripts/test-marker-migration.js && node scripts/test-integration-coexistence.js"
  },
  "devDependencies": {
